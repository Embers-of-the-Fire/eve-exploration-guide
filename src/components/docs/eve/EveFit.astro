---
import { Code } from "@astrojs/starlight/components";
import {
    registerEveFitRefs,
    resolveExtensionIdRenderMeta,
    type WithExtensionIdSourceProps,
} from "@astro-extension-ids/runtime";
import {
    createFitText,
    resolveFitSections,
    type EveFitData,
} from "./EveFit.shared";
import { eveFitSectionOrder } from "./EveFit.sections";
import EveFitList from "./EveFitList";
import styles from "./EveFit.module.css";

interface Props extends WithExtensionIdSourceProps {
    data: EveFitData;
    name: string;
    shipId: number;
}

const { __extensionIdFile, __extensionIdLine, data, name, shipId } =
    Astro.props as Props;
registerEveFitRefs(
    shipId,
    data,
    resolveExtensionIdRenderMeta(__extensionIdFile, __extensionIdLine),
);
const resolvedSections = resolveFitSections(data);
const fitText = createFitText(name, shipId, resolvedSections);
const sectionLabels = eveFitSectionOrder.map((key) => ({
    key,
    label: Astro.locals.t(`eveFit.section.${key}`),
}));
---

<div class={styles.fit}>
    <EveFitList
        name={name}
        sectionLabels={sectionLabels}
        sections={resolvedSections}
        shipId={shipId}
    />
    <div class={styles.codeBlock}>
        <Code code={fitText} lang="" />
    </div>
</div>
