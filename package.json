{
    "name": "eve-exploration-guide",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "astro check",
        "extract:extension-ids": "pnpm run build",
        "generate:eve-docs-data": "cd packages/eve-docs-generator && UV_CACHE_DIR=${UV_CACHE_DIR:-/tmp/eve-exploration-guide-uv-cache} uv run python -m eve_docs_generator --manifest ../../src/generated/extension-ids.json --output-dir ../../src/generated/eve",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "pnpm run lint:code && pnpm run lint:docs",
        "lint:code": "biome lint .",
        "lint:docs": "remark README.md \"src/**/*.md\" \"src/**/*.mdx\" --frail",
        "validate": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run build"
    },
    "dependencies": {
        "@astrojs/react": "^5.0.1",
        "@astrojs/starlight": "^0.38.2",
        "astro": "^6.0.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "rehype-accessible-emojis": "^0.3.2",
        "sharp": "^0.34.2",
        "starlight-blog": "^0.26.1",
        "starlight-cooler-credit": "^0.6.0",
        "starlight-giscus": "^0.9.1",
        "starlight-image-zoom": "^0.14.1",
        "starlight-sidebar-topics": "^0.7.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.8",
        "@biomejs/biome": "^2.4.8",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "prettier": "^3.8.1",
        "prettier-plugin-astro": "^0.14.1",
        "remark-cli": "^12.0.1",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-mdx": "^3.1.1",
        "remark-preset-lint-recommended": "^7.0.1",
        "typescript": "^5.9.3"
    }
}
